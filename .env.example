# Next.js reads .env.local. `npx convex dev` writes the three Convex values for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# From your Clerk application (Dashboard > API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Set on the Convex deployment, NOT in .env.local (scripts/setup-local.sh does this):
#   CLERK_JWT_ISSUER_DOMAIN     Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
#   ADMIN_EMAILS                comma-separated verified emails that become admin on first sign-in
#   CONVEX_TO_N8N_SECRET        HMAC secret: Convex signs loan events, n8n verifies
#   N8N_TO_CONVEX_SECRET        HMAC secret: n8n signs its calls, Convex verifies
#   N8N_LOAN_EVENT_WEBHOOK_URL  e.g. http://localhost:5678/webhook/lendloop-loan-event
#   APP_URL                     used for links in emails, e.g. http://localhost:3000
#
# n8n reads .env.n8n (generated by the setup script, gitignored):
#   CONVEX_TO_N8N_SECRET, N8N_TO_CONVEX_SECRET, N8N_ENCRYPTION_KEY, CONVEX_SITE_URL
#   Optional: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_SECURE, LENDLOOP_FROM_EMAIL
